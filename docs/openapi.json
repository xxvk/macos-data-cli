  "components": {
    "schemas": {
      "ContactPayload": {
        "description": "Adapter-neutral contact payload exchanged with agents and scripts.",
        "properties": {
          "addresses": {
            "items": {
              "$ref": "#/components/schemas/PostalAddress"
            },
            "type": "array"
          },
          "department": {
            "description": "Department.",
            "type": "string"
          },
          "emails": {
            "items": {
              "$ref": "#/components/schemas/LabeledValue"
            },
            "type": "array"
          },
          "externalID": {
            "description": "Stable external ID; required for every CLI-created contact.",
            "type": "string"
          },
          "familyName": {
            "description": "Family name.",
            "type": "string"
          },
          "givenName": {
            "description": "Given name.",
            "type": "string"
          },
          "imageAvailable": {
            "description": "Read-only avatar availability.",
            "type": "boolean"
          },
          "jobTitle": {
            "description": "Job title.",
            "type": "string"
          },
          "kind": {
            "description": "Contact kind.",
            "enum": [
              "person",
              "organization"
            ],
            "type": "string"
          },
          "metadata": {
            "description": "Arbitrary string metadata; preserved in JSON but not persisted by the Contacts adapter.",
            "properties": {},
            "required": [],
            "type": "object"
          },
          "organizationName": {
            "description": "Organization name.",
            "type": "string"
          },
          "phones": {
            "items": {
              "$ref": "#/components/schemas/LabeledValue"
            },
            "type": "array"
          },
          "phoneticFamilyName": {
            "description": "Phonetic family name.",
            "type": "string"
          },
          "phoneticGivenName": {
            "description": "Phonetic given name.",
            "type": "string"
          },
          "urls": {
            "items": {
              "$ref": "#/components/schemas/LabeledValue"
            },
            "type": "array"
          }
        },
        "required": [
          "kind"
        ],
        "title": "ContactPayload",
        "type": "object"
      },
      "ContactWriteResult": {
        "description": "Final saved state after a Contacts write.",
        "properties": {
          "contact": {
            "$ref": "#/components/schemas/ContactPayload"
          },
          "operation": {
            "description": "Write operation name.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "LabeledValue": {
        "description": "A labeled string value.",
        "properties": {
          "label": {
            "description": "Optional label.",
            "type": "string"
          },
          "value": {
            "description": "Value.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "PostalAddress": {
        "description": "A postal address.",
        "properties": {
          "city": {
            "description": "City.",
            "type": "string"
          },
          "country": {
            "description": "Country.",
            "type": "string"
          },
          "label": {
            "description": "Optional label.",
            "type": "string"
          },
          "postalCode": {
            "description": "Postal code.",
            "type": "string"
          },
          "state": {
            "description": "State or region.",
            "type": "string"
          },
          "street": {
            "description": "Street line.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    }
  }
