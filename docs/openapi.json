    "/contacts/create": {
      "post": {
        "summary": "create",
        "description": "Create a contact.",
        "parameters": [
          {
            "name": "input",
            "in": "query",
            "description": "JSON file",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stdin",
            "in": "query",
            "description": "Read JSON from stdin",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "apply",
            "in": "query",
            "description": "Persist (else dry-run)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "idempotent",
            "in": "query",
            "description": "Opt-in create retry",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success envelope (ok=true, contractVersion, data).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactWriteResult"
                }
              }
            }
          }
        },
        "x-safety": {
          "apply": true,
          "dryRun": true
        },
        "x-exit-codes": [
          {
            "code": 2,
            "description": "Contacts/permission/input error",
            "errorCode": "CONTACTS_ERROR"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactPayload"
              }
            }
          }
        }
      }
    },
